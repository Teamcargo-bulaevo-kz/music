<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/harmonia_background" android:orientation="vertical"
    android:weightSum="1">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="20dp"
        android:paddingTop="14dp" android:paddingEnd="8dp">
        <TextView
            android:id="@+id/screenTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1"
            android:layout_weight="1" android:text="Harmonia" android:textColor="@color/harmonia_text"
            android:textSize="30sp" android:textStyle="bold" />
        <ImageButton
            android:id="@+id/shuffleAll" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Вперемешку"
            android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_shuffle" android:tint="@color/harmonia_cyan" />
        <ImageButton
            android:id="@+id/moreButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Ещё"
            android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_more" android:tint="@color/harmonia_text" />
    </LinearLayout>

    <EditText
        android:id="@+id/search" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:layout_marginEnd="16dp"
        android:background="@drawable/harmonia_search_bg" android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp" android:drawableTint="@color/harmonia_muted" android:hint="Поиск песен и исполнителей"
        android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1"
        android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="@color/harmonia_text"
        android:textColorHint="@color/harmonia_muted" android:textSize="15sp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:background="@drawable/harmonia_background"
        app:tabIndicatorColor="@color/harmonia_cyan" app:tabIndicatorFullWidth="false" app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable" app:tabRippleColor="@null" app:tabTextAppearance="@style/MusicTabText"
        app:tabSelectedTextColor="@color/harmonia_cyan" app:tabTextColor="@color/harmonia_muted" />

    <TextView
        android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginTop="8dp" android:layout_marginEnd="16dp"
        android:background="@drawable/banner_bg" android:padding="12dp"
        android:textColor="@color/harmonia_muted" android:textSize="13sp" android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="2dp" android:paddingTop="8dp" android:paddingEnd="2dp" android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/loadingHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center"
            android:text="Загружаю музыку…"
            android:textColor="@color/harmonia_muted" android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/miniPlayer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="10dp"
        android:background="@drawable/harmonia_mini_bg" android:orientation="vertical" android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="68dp" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="6dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/miniCover" android:layout_width="48dp" android:layout_height="48dp"
                android:scaleType="centerCrop" android:src="@drawable/cover_placeholder"
                app:shapeAppearanceOverlay="@style/Round12" />
            <LinearLayout
                android:id="@+id/miniInfo" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView
                    android:id="@+id/miniTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="@color/harmonia_text" android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/miniArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1" android:textColor="@color/harmonia_muted" android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/miniPrev" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Назад"
                android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_prev" />
            <ImageButton
                android:id="@+id/miniPlay" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/play_circle" android:contentDescription="Играть"
                android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_play" />
            <ImageButton
                android:id="@+id/miniNext" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Дальше"
                android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_next" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/miniProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp" android:layout_marginBottom="8dp"
            android:progressTint="@color/harmonia_cyan" android:progressBackgroundTint="@color/harmonia_stroke" />
    </LinearLayout>
</LinearLayout>
