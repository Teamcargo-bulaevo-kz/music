<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#05060F">

    <com.example.assistant.AuraView
        android:id="@+id/aura"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingStart="32dp" android:paddingEnd="32dp" android:paddingTop="8dp" android:paddingBottom="48dp">

        <ImageButton
            android:id="@+id/moreButton" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="end" android:alpha="0.6"
            android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Ещё"
            android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_more" />

        <FrameLayout
            android:id="@+id/coverBox" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:paddingStart="24dp" android:paddingEnd="24dp">
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/cover" android:layout_width="200dp" android:layout_height="200dp"
                android:layout_gravity="center" android:scaleType="centerCrop" android:src="@drawable/cover_placeholder"
                app:shapeAppearanceOverlay="@style/RoundFull" />
        </FrameLayout>

        <TextView
            android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end" android:gravity="center" android:maxLines="2"
            android:textColor="@color/harmonia_text" android:textSize="22sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:alpha="0.7" android:ellipsize="end" android:gravity="center" android:maxLines="1"
            android:textColor="@color/harmonia_muted" android:textSize="14sp" />

        <TextView
            android:id="@+id/tags" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/harmonia_cyan"
            android:textSize="12sp" android:visibility="gone" />
        <com.example.assistant.MoodProfileView
            android:id="@+id/moodProfile" android:layout_width="match_parent" android:layout_height="80dp"
            android:layout_marginTop="4dp" android:visibility="gone" />
        <com.example.assistant.SpectrumGlowView
            android:id="@+id/spectrum" android:layout_width="match_parent" android:layout_height="120dp"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="56dp" android:progressTint="#99B4B8CC" android:thumbTint="#B4B8CC"
            android:progressBackgroundTint="#22B4B8CC" />
        <LinearLayout
            android:id="@+id/timeRow"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView
                android:id="@+id/timeNow" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:alpha="0.6" android:textColor="@color/harmonia_muted" android:textSize="11sp" />
            <TextView
                android:id="@+id/timeTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:alpha="0.6" android:textColor="@color/harmonia_muted" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/debugButtons"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:gravity="center" android:orientation="horizontal" android:visibility="gone">
            <ImageButton
                android:id="@+id/shuffle" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Вперемешку"
                android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_shuffle" />
            <ImageButton
                android:id="@+id/repeat" android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginStart="24dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Повтор"
                android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_repeat" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="36dp"
            android:gravity="center" android:orientation="horizontal">
            <ImageButton
                android:id="@+id/dislikeButton" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Не нравится"
                android:padding="12dp" android:scaleType="fitCenter" android:tint="#9EA3BA" android:src="@drawable/ic_thumb_down" />
            <ImageButton
                android:id="@+id/prev" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Назад"
                android:padding="12dp" android:scaleType="fitCenter" android:tint="#9EA3BA" android:src="@drawable/ic_prev" />
            <ImageButton
                android:id="@+id/play" android:layout_width="60dp" android:layout_height="60dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:background="@drawable/harmonia_play_circle" android:contentDescription="Играть"
                android:padding="16dp" android:scaleType="fitCenter" android:src="@drawable/ic_play" />
            <ImageButton
                android:id="@+id/next" android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Дальше"
                android:padding="12dp" android:scaleType="fitCenter" android:tint="#9EA3BA" android:src="@drawable/ic_next" />
            <ImageButton
                android:id="@+id/likeButton" android:layout_width="44dp" android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Нравится"
                android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_heart" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
