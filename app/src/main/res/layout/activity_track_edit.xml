<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/harmonia_background" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:id="@+id/editTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/harmonia_text" android:textSize="22sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/editArtist" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textColor="@color/harmonia_muted" android:textSize="16sp" />
        <TextView
            android:id="@+id/editInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/harmonia_cyan" android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/likeBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="♡ Нравится" android:textColor="@color/harmonia_text"
                app:strokeColor="@color/harmonia_violet" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/dislikeBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:layout_weight="1" android:text="Не нравится" android:textColor="@color/harmonia_text"
                app:strokeColor="@color/harmonia_stroke" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Настроение (можно несколько)" android:textColor="@color/harmonia_text" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/moodBox" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Жанр" android:textColor="@color/harmonia_text" android:textSize="15sp" android:textStyle="bold" />
        <Spinner
            android:id="@+id/genreSpinner" android:layout_width="match_parent" android:layout_height="48dp"
            android:backgroundTint="@color/harmonia_violet" />
        <EditText
            android:id="@+id/genreLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Своя подпись жанра (необязательно)" android:inputType="text"
            android:textColor="@color/harmonia_text" android:textColorHint="@color/harmonia_muted"
            android:backgroundTint="@color/harmonia_violet" android:textSize="15sp" />

        <TextView
            android:id="@+id/energyText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="@color/harmonia_text" android:textSize="15sp" android:textStyle="bold" />
        <SeekBar
            android:id="@+id/energySeek" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:max="4" android:progressTint="@color/harmonia_cyan" android:thumbTint="@color/harmonia_violet" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Темп" android:textColor="@color/harmonia_text" android:textSize="15sp" android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/tempoGroup" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Описание" android:textColor="@color/harmonia_text" android:textSize="15sp" android:textStyle="bold" />
        <EditText
            android:id="@+id/descEdit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Коротко о песне" android:inputType="textMultiLine" android:maxLines="3"
            android:textColor="@color/harmonia_text" android:textColorHint="@color/harmonia_muted"
            android:backgroundTint="@color/harmonia_violet" android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="Папки" android:textColor="@color/harmonia_text" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/folderBox" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />
        <EditText
            android:id="@+id/newFolder" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Новая папка (необязательно)" android:inputType="text"
            android:textColor="@color/harmonia_text" android:textColorHint="@color/harmonia_muted"
            android:backgroundTint="@color/harmonia_violet" android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="Сохранить"
            android:backgroundTint="@color/harmonia_violet" android:textColor="@color/harmonia_text" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Всё верно" android:visibility="gone"
            android:textColor="@color/harmonia_text" />
    </LinearLayout>
</ScrollView>
