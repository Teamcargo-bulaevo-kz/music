<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 и новее: резервная копия в облаке Google и перенос на новый телефон -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="external" path="Музыка/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="external" path="Музыка/" />
    </device-transfer>
</data-extraction-rules>
