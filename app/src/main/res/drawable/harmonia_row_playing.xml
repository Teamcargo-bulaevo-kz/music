<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#667DEBFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#292442" android:endColor="#172B3C"/>
            <stroke android:width="1.5dp" android:color="#7187D9FF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</ripple>