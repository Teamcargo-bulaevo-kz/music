<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#668C7BFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#D0282478" android:endColor="#D01E2C8C"/>
            <stroke android:width="1.5dp" android:color="#B38C7BFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</ripple>
