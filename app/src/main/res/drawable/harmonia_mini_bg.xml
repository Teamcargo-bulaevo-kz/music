<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#668CDEFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#242744" android:centerColor="#1B223A" android:endColor="#172E3B"/>
            <stroke android:width="1dp" android:color="#776BC0"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
</ripple>