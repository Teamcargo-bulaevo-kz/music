<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#668C7BFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F01B2160" android:centerColor="#F0261E70" android:endColor="#F01A1B5A"/>
            <stroke android:width="1dp" android:color="#998C7BFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
<corners android:radius="22dp"/>
        </shape>
    </item>
</ripple>
