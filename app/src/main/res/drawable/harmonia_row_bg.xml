<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#557D8CFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1B2034" android:endColor="#121D2D"/>
            <stroke android:width="1dp" android:color="#3A4562"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</ripple>